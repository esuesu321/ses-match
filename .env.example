# AI評価を利用する場合に設定します。認証キーはサーバー側だけで使用します。
# AI_ENDPOINT：AIへの問い合わせ先（Chat Completions互換の完全なURL）
# AI_API_KEY：接続先サービスの認証キー
# AI_MODEL：利用するAIモデルの識別名
# PORT：画面を開くための接続番号（通常は4317）
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
PORT=4317

# 自己管理サーバーのHTTPSプロキシ経由で利用する場合のみ設定。
# 未設定の場合は従来通りPC内だけで動作します。
SES_PUBLIC_ORIGIN=
SES_AUTH_USER=
# ランダム生成した24文字以上のパスワード。GitHubへ保存しないでください。
SES_AUTH_PASSWORD=
# 実データはコードと別の保護された場所へ保存できます。
SES_DB=

# 本人のChatGPT契約枠を使う場合のみchatgpt。APIキー方式へ自動切替しません。
SES_AI_MODE=chatgpt
# 初回接続で保護された認証情報を保存する場所。空欄ならユーザープロファイル配下。
SES_CHATGPT_DIR=
